# Nostradamus API Keys
# =====================
# These keys are used by the browser app (stored in localStorage via Settings panel)
# and by GitHub Actions workflows (stored as repository secrets).
#
# ALL KEYS ARE OPTIONAL. The app works in demo mode without any keys.
# When keys are configured, they're used in this fallback order:
#   1. Finnhub (primary)    — Free: 60 API calls/min
#   2. Twelve Data          — Free: 800 calls/day, 8 calls/min
#   3. Polygon.io           — Free: unlimited (prev-day data only)
#
# Get free API keys at:
#   Finnhub:     https://finnhub.io/register
#   Twelve Data: https://twelvedata.com/pricing
#   Polygon.io:  https://polygon.io/pricing

# Required for real-time quotes and WebSocket streaming
FINNHUB_API_KEY=

# Optional — secondary fallback for quotes and time series
TWELVEDATA_API_KEY=

# Optional — tertiary fallback, good for previous-close data
POLYGON_API_KEY=

# Note: The nightly historical data pipeline (fetch-history.py) uses
# yfinance which does NOT require an API key. Data is fetched from
# Yahoo Finance for free with no rate limits.

# ---------------------------------------------------------------------------
# Extended data canal (optional — improves fallback + regime features)
# ---------------------------------------------------------------------------
# Tiingo: https://www.tiingo.com/ — 500 symbols, 50k calls/month free
TIINGO_API_TOKEN=

# Alpha Vantage: https://www.alphavantage.co/support/#api-key — 25 calls/day
ALPHAVANTAGE_API_KEY=

# FRED API (optional; public CSV works without key)
FRED_API_KEY=

# GDELT query override for regime tone
GDELT_QUERY=(stock market) OR (equities) OR (S&P 500)

# Regime fetch tuning
REGIME_GDELT_LOOKBACK_DAYS=365
REGIME_GDELT_CHUNK_DAYS=30

# ---------------------------------------------------------------------------
# Broker / Robinhood Agents preparation
# ---------------------------------------------------------------------------
# paper | dry_run | manifest_only | robinhood_agents
BROKER_MODE=manifest_only
BROKER_PORTFOLIO_VALUE=10000
BROKER_MAX_GROSS_EXPOSURE=0.90
BROKER_MAX_POSITION_FRAC=0.20
BROKER_MIN_PROBA=0.60

# Orchestrator: block pipeline when feeds unhealthy
ORCHESTRATOR_REQUIRE_HEALTH=true
SKIP_PREDICTOR_TRAIN=true

# ---------------------------------------------------------------------------
# Congressional trade tracking (Pelosi-tracker style)
# ---------------------------------------------------------------------------
# Quiver Quantitative — https://www.quiverquant.com/api-setup/
QUIVER_API_KEY=

# Self-hosted capitol-api — https://github.com/crnicholson/capitol-api
CAPITOL_API_URL=

# Boost investor ranking + Robinhood order size when politicians are buying
CONGRESS_BOOST_ENABLED=true
CONGRESS_POLICY_WEIGHT=0.12
CONGRESS_PELOSI_EXTRA=0.05
CONGRESS_TRADE_BOOST=true
CONGRESS_MIN_SCORE=0

# ---------------------------------------------------------------------------
# Autonomous learning harness
# ---------------------------------------------------------------------------
LEARNING_LOOP_HOURS=24
SKIP_PREDICTOR_TRAIN=false
INSIDER_FETCH_LIMIT=120
PREFER_NPU=true
ONNX_EXECUTION_PROVIDERS=

# Paper Agent Model (2nd ML model, separate from predictor)
# ----------------------------------------------------------
# Fake-money bankroll for day-to-day paper investing simulation.
PAPER_AGENT_STARTING_CASH=10000

# Max symbols traded per simulated day.
PAPER_AGENT_MAX_POSITIONS=8

# Minimum model score (0-1) required to open a trade.
PAPER_AGENT_MIN_BUY_SCORE=0.54

# Per-side transaction fee in basis points (2 bps = 0.02%).
PAPER_AGENT_TRADE_FEE_BPS=2.0

# Max historical days to replay from data/accuracy/*.json (252 ~= 1 year).
PAPER_AGENT_LOOKBACK_DAYS=252

# Max fraction of portfolio deployed each day (rest remains in cash).
PAPER_AGENT_MAX_DAILY_EXPOSURE_PCT=0.85

# Max fraction of portfolio allocated to one position.
PAPER_AGENT_MAX_POSITION_PCT=0.22

# Optional short controls.
PAPER_AGENT_ENABLE_SHORTS=false
PAPER_AGENT_SHORT_ALLOC_PCT=0.25

# Profit gate (used by paper-agent-profit-gate.py).
PAPER_AGENT_GATE_MIN_DAYS=25
PAPER_AGENT_GATE_MIN_TRADES=120
PAPER_AGENT_GATE_MIN_TOTAL_RETURN_PCT=0.0
PAPER_AGENT_GATE_MAX_DRAWDOWN_PCT=9.0
PAPER_AGENT_GATE_MIN_ONLINE_DELTA=-0.01
PAPER_AGENT_GATE_SEVERE_LOSS_TRIGGER_PCT=-2.0
PAPER_AGENT_GATE_RECENT_WINDOW_DAYS=20
PAPER_AGENT_GATE_MIN_RECENT_RETURN_PCT=-0.5
PAPER_AGENT_GATE_MAX_RECENT_DRAWDOWN_PCT=5.0
